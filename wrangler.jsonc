{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parenting-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "parenting-lab",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "triggers": { "crons": ["17 22 * * *"] }
}
